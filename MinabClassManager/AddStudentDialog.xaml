<Window x:Class="MinabClassManager.AddStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student"
        Width="340"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#f8fafc"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="24,20,24,24">

        <!-- Header -->
        <TextBlock x:Name="titleText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#1e3a5f"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <!-- Name field -->
        <TextBlock Text="Student name"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="#64748b"
                   Margin="0,0,0,5"/>
        <TextBox x:Name="nameBox"
                 Padding="10,8"
                 FontSize="13"
                 BorderBrush="#cbd5e1"
                 BorderThickness="1"
                 Background="White"
                 KeyDown="NameBox_KeyDown"/>

        <Separator Background="#e2e8f0" Margin="0,18,0,14"/>

        <!-- Media options -->
        <TextBlock Text="Media (fake devices)"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="#64748b"
                   Margin="0,0,0,10"/>

        <CheckBox x:Name="cameraCheck"
                  Content="Fake Camera"
                  IsChecked="True"
                  FontSize="13"
                  Foreground="#374151"
                  Margin="0,0,0,8"/>

        <CheckBox x:Name="micCheck"
                  Content="Fake Microphone"
                  IsChecked="True"
                  FontSize="13"
                  Foreground="#374151"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Width="80"
                    Click="CancelButton_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Add Student"
                    Style="{StaticResource PrimaryButton}"
                    Width="110"
                    IsDefault="True"
                    Click="AddButton_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
