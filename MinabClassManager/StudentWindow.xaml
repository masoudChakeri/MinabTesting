<Window x:Class="MinabClassManager.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Student"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Browser -->
        <wv2:WebView2 x:Name="webView"/>

        <!-- Loading overlay shown until WebView2 is ready -->
        <Grid x:Name="loadingOverlay" Background="#faf7f1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                <TextBlock x:Name="loadingText"
                           Text="Starting browser session…"
                           HorizontalAlignment="Center"
                           FontSize="15" Foreground="#475569"/>
                <ProgressBar IsIndeterminate="True"
                             Height="4" Margin="0,14,0,0"
                             Foreground="#0e7490"
                             Background="#e2e8f0"
                             BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
