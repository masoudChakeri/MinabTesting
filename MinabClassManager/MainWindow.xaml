<Window x:Class="MinabClassManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minab Class Manager"
        Width="900" Height="660"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#f1f5f9"
        FontFamily="Segoe UI"
        FontSize="13">

    <DockPanel LastChildFill="True">

        <!-- ── Top toolbar ── -->
        <Border DockPanel.Dock="Top" Background="#1e3a5f" Padding="18,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Minab Class Manager"
                               Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="fileInfoText"
                               Foreground="#94a3b8" FontSize="12"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="📂  Import JSON / JSONL"
                        Style="{StaticResource PrimaryButton}"
                        Background="#2a5298"
                        Click="ImportButton_Click"/>
            </Grid>
        </Border>

        <!-- ── Status bar ── -->
        <Border DockPanel.Dock="Bottom" Background="#e2e8f0" Padding="18,5">
            <TextBlock x:Name="statusText" FontSize="12" Foreground="#475569"/>
        </Border>

        <!-- ── Two-panel content ── -->
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="130"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*" MinHeight="110"/>
            </Grid.RowDefinitions>

            <!-- Classes panel -->
            <Border Grid.Row="0" Background="White" CornerRadius="6"
                    BorderBrush="#e2e8f0" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#f8fafc"
                            BorderBrush="#e2e8f0" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <TextBlock Text="Classes"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#1e3a5f"/>
                    </Border>

                    <DataGrid x:Name="classGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#f1f5f9"
                              HeadersVisibility="Column"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#fafafa"
                              BorderThickness="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ColumnHeaderHeight="34"
                              RowHeight="40"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                               Binding="{Binding Index}"
                                               Width="50"/>
                            <DataGridTextColumn Header="Title"
                                               Binding="{Binding Title}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Starts At (UTC)"
                                               Binding="{Binding StartsAt}"
                                               Width="200"/>
                            <DataGridTemplateColumn Header="Action" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="＋ Add Student"
                                                Style="{StaticResource AddButton}"
                                                Tag="{Binding}"
                                                Click="AddStudentButton_Click"
                                                Margin="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Drag handle -->
            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          Background="#cbd5e1"
                          Cursor="SizeNS"/>

            <!-- Students panel -->
            <Border Grid.Row="2" Background="White" CornerRadius="6"
                    BorderBrush="#e2e8f0" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#f8fafc"
                            BorderBrush="#e2e8f0" BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <TextBlock Text="Added Students (this session)"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#1e3a5f"/>
                    </Border>

                    <DataGrid x:Name="studentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#f1f5f9"
                              HeadersVisibility="Column"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#fafafa"
                              BorderThickness="0"
                              VerticalScrollBarVisibility="Auto"
                              ColumnHeaderHeight="34"
                              RowHeight="40"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                               Binding="{Binding Name}"
                                               Width="100"/>
                            <DataGridTextColumn Header="Class"
                                               Binding="{Binding ClassTitle}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Camera"
                                               Binding="{Binding CameraDisplay}"
                                               Width="90"/>
                            <DataGridTextColumn Header="Mic"
                                               Binding="{Binding MicDisplay}"
                                               Width="80"/>
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                                Style="{StaticResource RemoveButton}"
                                                Tag="{Binding}"
                                                Click="RemoveStudentButton_Click"
                                                Margin="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
